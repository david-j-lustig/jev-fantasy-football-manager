# Copy to jev-ff.toml in the working directory, or to ~/.config/jev-ff/config.toml
#
# API keys (TYPESAFE_API_KEY, OPENAI_API_KEY) are environment-only. Keys in this file are rejected.

league_id = "your-sleeper-league-id"
roster_id = 1
# username = "your-sleeper-username"
model = "jev-latest"   # or "gpt-6-luna" with OPENAI_API_KEY
